<!DOCTYPE html>
<html lang="en">
  <head>
    <style>
      body {
        font-family: Tahoma, sans-serif;
      }
      table {
        border-collapse: collapse;
        width: 100%;
      }
      th,
      td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: left;
      }
      th {
        background: #f5f5f5;
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin URLs</title>
  </head>
  <body>
    <h1>Admin Dashboard</h1>
    <p>All shortened URLs in the system.</p>

    <% if (locals.urls && urls.length) { %>
    <table>
      <thead>
        <tr>
          <th>S.No</th>
          <th>ShortId</th>
          <th>Redirect</th>
          <th>Clicks</th>
          <th>Owner</th>
        </tr>
      </thead>
      <tbody>
        <% urls.forEach((url, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= url.shortId %></td>
          <td><%= url.redirectedURL %></td>
          <td><%= url.visistedHistory.length %></td>
          <td><%= url.createdBy %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p>No URLs found.</p>
    <% } %>
  </body>
</html>
